<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}E-commerce{% endblock %}</title>

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>

    <body>

        {% if app.user %}
            <nav>
                <h2>Administration</h2>

                <ul>
                    <li>
                        <a href="{{ path('app_produit') }}">
                            🛍️ Catalogue
                        </a>
                    </li>

                    <li>
                        <a href="{{ path('admin_produit_ajouter') }}">
                            ➕ Ajouter un produit
                        </a>
                    </li>

                    <li>
                        <a href="{{ path('admin_clients') }}">
                            👥 Clients
                        </a>
                    </li>

                    <li>
                        <a href="{{ path('admin_commandes') }}">
                            📋 Commandes
                        </a>
                    </li>

                    <li>
                        <a href="{{ path('app_logout') }}">
                            🚪 Déconnexion
                        </a>
                    </li>
                </ul>

                <hr>
            </nav>
        {% endif %}

        {% block body %}
        {% endblock %}

    </body>
</html>