{% extends 'base.html.twig' %}

{% block title %}Gestion des produits{% endblock %}

{% block body %}

<h1>Gestion des produits</h1>

<p>
    <a href="{{ path('admin_produit_ajouter') }}">
        ➕ Ajouter un produit
    </a>
</p>

{% if produits is empty %}

    <p>Aucun produit enregistré.</p>

{% else %}

    {% for produit in produits %}

        <div>
            <h2>{{ produit.designation }}</h2>

            <p>
                <strong>Description :</strong>
                {{ produit.description }}
            </p>

            <p>
                <strong>Prix :</strong>
                {{ produit.prix }} €
            </p>

            <p>
                <strong>Quantité :</strong>
                {{ produit.quantite }}
            </p>

            <p>
                <strong>Disponibilité :</strong>

                {% if produit.disponible and produit.quantite > 0 %}
                    ✅ Disponible
                {% else %}
                    ❌ Indisponible
                {% endif %}
            </p>

            <a href="{{ path('admin_produit_modifier', {id: produit.id}) }}">
                ✏️ Modifier
            </a>

            <br><br>

            <form method="post"
                  action="{{ path('admin_produit_supprimer', {id: produit.id}) }}"style="display:inline;">

                <input
                    type="hidden"
                    name="_token"
                    value="{{ csrf_token('supprimer_produit_' ~ produit.id) }}"
                >

                <button type="submit">
                    🗑️ Retirer du catalogue
                </button>

            </form>

        </div>

        <hr>

    {% endfor %}

{% endif %}

{% endblock %}