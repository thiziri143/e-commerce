{% extends 'base.html.twig' %}

{% block title %}Catalogue des produits{% endblock %}

{% block body %}

<h1>Catalogue des produits</h1>

{% if produits is empty %}

    <p>Aucun produit disponible.</p>

{% else %}

    {% for produit in produits %}

        <div>
            <h2>{{ produit.designation }}</h2>

            <p>{{ produit.description }}</p>

            <p>
                <strong>Prix :</strong>
                {{ produit.prix }} €
            </p>

            {% if produit.disponible and produit.quantite > 0 %}

                <p>
                    <strong>Quantité disponible :</strong>
                    {{ produit.quantite }}
                </p>

                <p>✅ Produit disponible</p>

                <a href="{{ path('panier_ajouter', {id: produit.id}) }}">
                    🛒 Ajouter au panier
                </a>

            {% else %}

                <p>🔄 Réapprovisionnement en cours</p>

            {% endif %}

            <br><br>

            <a href="{{ path('admin_produit_modifier', {id: produit.id}) }}">
                ✏️ Modifier
            </a>

            <br><br>

            <a href="{{ path('admin_produit_supprimer', {id: produit.id}) }}">
                🗑️ Retirer du catalogue
            </a>

        </div>

        <hr>

    {% endfor %}

{% endif %}

{% endblock %}